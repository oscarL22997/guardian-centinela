# Copiar a .env solo si se quiere cambiar algo. compose.yaml funciona SIN este archivo (usa estos valores por defecto).
POSTGRES_PASSWORD=centinela_local
# Tiempo máximo que el dominio espera a la IA antes de aplicar la política de reserva (RNF3)
IA_TIMEOUT_MS=300
# Clave del rol riesgo para publicar nuevos umbrales (POST /api/dominio/umbrales). Vacía = deshabilitado.
RIESGO_API_KEY=
